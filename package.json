{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint . --fix",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "prepare": "husky",
        "test": "php artisan test"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx,vue,css,scss,md,json}": [
            "prettier --write"
        ],
        "**/*.php": [
            "vendor/bin/pint"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "laravel-vite-plugin": "^2.0.0",
        "lint-staged": "^16.2.7",
        "prettier": "3.7.4",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.53.0",
        "vite": "^7.0.7"
    }
}
